{
  "name": "agriwise",
  "version": "1.0.0",
  "description": "AgriWise - Smart Agriculture, Farm Management & Market Intelligence Platform",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "build": "npm --prefix frontend run build",
    "frontend": "npm --prefix frontend run dev",
    "backend": "venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "start": "uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}